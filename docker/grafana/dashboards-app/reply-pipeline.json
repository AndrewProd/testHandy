      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer lag (delivered seq \u2212 ack floor seq)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
