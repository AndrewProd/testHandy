          "refId": "B",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_consumer_num_redelivered",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "C",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_consumer_delivered_stream_seq",
