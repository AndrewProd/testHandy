          },
          "expr": "nats_consumer_num_ack_pending{consumer_name=\"reply-center\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Redelivering \u2014 retries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
