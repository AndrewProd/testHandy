{
  "uid": "reply-pipeline",
  "title": "Reply Pipeline \u2014 jobs & events",
  "tags": [
    "reply-center",
    "nats",
    "jetstream"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom_ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Throughput \u2014 reply.received \u2192 job \u2192 events",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Events received",
      "description": "reply.received events published to the INBOUND stream in the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "increase(nats_stream_last_seq{stream=\"INBOUND\"}[$__range])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Events published to bus",
      "description": "events.reply.processed published by outbox:relay in the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "increase(nats_stream_last_seq{stream=\"OUTBOUND\"}[$__range])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Processed (acked) by reply-center",
      "description": "Messages the consumer delivered AND acknowledged (job ran to completion)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "increase(nats_consumer_ack_floor_stream_seq{consumer_name=\"reply-center\"}[$__range])",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ack ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "clamp_max(increase(nats_consumer_ack_floor_stream_seq{consumer_name=\"reply-center\"}[$__range]) / clamp_min(increase(nats_stream_last_seq{stream=\"INBOUND\"}[$__range]), 1), 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages / sec",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "rate(nats_stream_last_seq{stream=\"INBOUND\"}[$__rate_interval])",
          "legendFormat": "in: reply.received",
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "rate(nats_stream_last_seq{stream=\"OUTBOUND\"}[$__rate_interval])",
          "legendFormat": "out: events.reply.processed",
          "instant": false,
          "format": "time_series",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer: delivered vs acked / sec",
      "description": "If delivered outruns acked, jobs are piling up or failing",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "rate(nats_consumer_delivered_stream_seq{consumer_name=\"reply-center\"}[$__rate_interval])",
          "legendFormat": "delivered/s",
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "rate(nats_consumer_ack_floor_stream_seq{consumer_name=\"reply-center\"}[$__rate_interval])",
          "legendFormat": "acked/s",
          "instant": false,
          "format": "time_series",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Backlog & retries (Horizon-style)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Backlog \u2014 unprocessed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_consumer_num_pending{consumer_name=\"reply-center\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "In-flight \u2014 delivered, not acked",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calc": "lastNotNull"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
