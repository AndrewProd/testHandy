      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_consumer_delivered_stream_seq{consumer_name=\"reply-center\"} - nats_consumer_ack_floor_stream_seq{consumer_name=\"reply-center\"}",
          "legendFormat": "lag (messages)",
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Snapshot",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Streams",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "messages"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "last_seq (total ever)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "bytes"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "consumers"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "server_id": true,
              "server_name": true,
              "account": true,
              "account_name": true,
              "cluster_name": true,
              "raft_group": true,
              "stream_leader": true,
              "consumer_leader": true,
              "server_cluster": true
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_stream_total_messages",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "A",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_stream_last_seq",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "B",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_stream_total_bytes",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "C",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "nats_stream_consumer_count",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "D",
          "range": false
        }
      ]
    },
