<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="db" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <!-- Separate database: RefreshDatabase must never touch dev data. -->
        <env name="DB_DATABASE" value="reply_center_test" force="true"/>
        <env name="DB_USERNAME" value="app" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
    </php>
</phpunit>
